// Cloudflare Workers: liefert die statische Website aus diesem Ordner aus (Umzug von Vercel, 05.11.2026)
{
  "name": "tephrawebsite",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": ".",
    // Eigene 404.html statt der Browser-Fehlerseite, wie vorher bei Vercel
    "not_found_handling": "404-page",
    // /handwerk und /handwerk/ führen beide zur Seite
    "html_handling": "auto-trailing-slash"
  }
}
